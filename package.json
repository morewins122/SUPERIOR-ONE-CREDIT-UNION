{
  "name": "superior-one-credit-union",
  "version": "1.0.0",
  "description": "Full-stack credit union banking platform.",
  "private": true,
  "scripts": {
    "dev:web": "npm --workspace superior-one-web run dev",
    "dev:api": "npm --workspace superior-one-api run dev",
    "dev": "npm run dev:api",
    "build": "npm run build --workspaces",
